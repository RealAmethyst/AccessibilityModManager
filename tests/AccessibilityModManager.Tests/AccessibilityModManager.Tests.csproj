<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AccessibilityModManager.Core\AccessibilityModManager.Core.csproj" />
    <ProjectReference Include="..\..\src\AccessibilityModManager.Infrastructure\AccessibilityModManager.Infrastructure.csproj" />
    <!-- The AuthorTool holds the signing-key store: security-critical, and previously untestable
         because nothing referenced it. -->
    <ProjectReference Include="..\..\src\AccessibilityModManager.AuthorTool\AccessibilityModManager.AuthorTool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The frozen wire vectors the server implementation is held to as well. -->
    <None Update="CatalogClaims\golden\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
