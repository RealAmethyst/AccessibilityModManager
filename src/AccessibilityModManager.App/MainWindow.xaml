<Window x:Class="AccessibilityModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AccessibilityModManager.App.ViewModels"
        xmlns:views="clr-namespace:AccessibilityModManager.App.Views"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Accessibility Mod Manager"
        Height="650" Width="900"
        MinHeight="400" MinWidth="600"
        AutomationProperties.Name="Accessibility Mod Manager">

    <Grid>
        <!-- Main navigation layout — visible only when no overlay is shown. -->
        <Grid Visibility="{Binding IsMainContentVisible, Converter={StaticResource BoolToVisConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Update notification is now a modal dialog (UpdateAvailableDialog) that pops
                 on launch when an update is found. No inline banner here — Row 0 is reserved
                 as a no-op spacer to keep the rest of the grid layout the same. -->


            <!-- Tab headers only. Mods is index 0 so it's the default landing tab. -->
            <TabControl x:Name="TabHeaders"
                        Grid.Row="1"
                        SelectedIndex="{Binding SelectedTabIndex}">
                <TabItem Header="Mods" AutomationProperties.Name="Mods"/>
                <TabItem Header="Authors" AutomationProperties.Name="Authors"/>
                <TabItem Header="Settings" AutomationProperties.Name="Settings"/>
            </TabControl>

            <!-- Per-tab heading + action buttons (outside tab control) -->
            <StackPanel Grid.Row="2" Margin="16,12,16,0">
                <!-- Mods heading (tab index 0) -->
                <StackPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToVisConverter}, ConverterParameter=0}">
                    <TextBlock Text="Mods" FontSize="24" FontWeight="Bold"
                               AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,8"/>
                    <Button Content="Refresh Mods"
                            Command="{Binding GamesListVm.RefreshGamesCommand}"
                            AutomationProperties.Name="Refresh mods"
                            HorizontalAlignment="Left" Margin="0,0,0,4"/>
                </StackPanel>
                <!-- Authors heading (tab index 1) -->
                <StackPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToVisConverter}, ConverterParameter=1}">
                    <TextBlock Text="Authors" FontSize="24" FontWeight="Bold"
                               AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,8"/>
                    <Button Content="Refresh Authors"
                            Command="{Binding PluginsVm.LoadPluginsCommand}"
                            AutomationProperties.Name="Refresh authors"
                            HorizontalAlignment="Left" Margin="0,0,0,4"/>
                </StackPanel>
                <!-- Settings heading (tab index 2) -->
                <StackPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToVisConverter}, ConverterParameter=2}">
                    <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"
                               AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,8"/>
                </StackPanel>
            </StackPanel>

            <!-- Tab content. Each view is wrapped in a Grid that keeps the inherited
                 MainViewModel DataContext so the Visibility binding resolves correctly.
                 The inner view sets its own DataContext to the relevant child VM. -->
            <Grid Grid.Row="3">
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToVisConverter}, ConverterParameter=0}">
                    <views:GamesListView x:Name="GamesTabView" DataContext="{Binding GamesListVm}"/>
                </Grid>
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToVisConverter}, ConverterParameter=1}">
                    <views:PluginsView x:Name="DevelopersTabView" DataContext="{Binding PluginsVm}"/>
                </Grid>
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToVisConverter}, ConverterParameter=2}">
                    <views:SettingsView DataContext="{Binding SettingsVm}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Developer details overlay — visible when its VM is set AND Game Details isn't on top. -->
        <Grid Visibility="{Binding IsDeveloperDetailsVisible, Converter={StaticResource BoolToVisConverter}}">
            <views:DeveloperDetailsView x:Name="DeveloperDetailsViewControl" DataContext="{Binding DeveloperDetailsVm}"/>
        </Grid>

        <!-- Game details overlay (top of the z-stack). -->
        <Grid Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVisConverter}}">
            <views:GameDetailsView DataContext="{Binding GameDetailsVm}"/>
        </Grid>
    </Grid>
</Window>
