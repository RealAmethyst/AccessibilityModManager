<Window x:Class="AccessibilityModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AccessibilityModManager.App.ViewModels"
        xmlns:views="clr-namespace:AccessibilityModManager.App.Views"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Accessibility Mod Manager"
        Height="650" Width="900"
        MinHeight="400" MinWidth="600"
        AutomationProperties.Name="Accessibility Mod Manager">

    <Grid>
        <!-- Main navigation layout -->
        <Grid Visibility="{Binding IsDetailsOpen, Converter={StaticResource InvertBoolToVisConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab headers only -->
            <TabControl x:Name="TabHeaders"
                        Grid.Row="0"
                        SelectedIndex="{Binding SelectedTabIndex}">
                <TabItem Header="Plugins" AutomationProperties.Name="Plugins"/>
                <TabItem Header="Games" AutomationProperties.Name="Games"/>
                <TabItem Header="Settings" AutomationProperties.Name="Settings"/>
            </TabControl>

            <!-- Per-tab heading + action buttons (outside tab control) -->
            <StackPanel Grid.Row="1" Margin="16,12,16,0">
                <!-- Plugins heading -->
                <StackPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToVisConverter}, ConverterParameter=0}">
                    <TextBlock Text="Plugins" FontSize="24" FontWeight="Bold"
                               AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,8"/>
                    <Button Content="Refresh Plugins"
                            Command="{Binding PluginsVm.LoadPluginsCommand}"
                            AutomationProperties.Name="Refresh plugins"
                            HorizontalAlignment="Left" Margin="0,0,0,4"/>
                </StackPanel>
                <!-- Games heading -->
                <StackPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToVisConverter}, ConverterParameter=1}">
                    <TextBlock Text="Games" FontSize="24" FontWeight="Bold"
                               AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,8"/>
                    <Button Content="Refresh Games"
                            Command="{Binding GamesListVm.RefreshGamesCommand}"
                            AutomationProperties.Name="Refresh games"
                            HorizontalAlignment="Left" Margin="0,0,0,4"/>
                </StackPanel>
                <!-- Settings heading -->
                <StackPanel Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToVisConverter}, ConverterParameter=2}">
                    <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"
                               AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,8"/>
                </StackPanel>
            </StackPanel>

            <!-- Tab content -->
            <Grid Grid.Row="2">
                <views:PluginsView DataContext="{Binding PluginsVm}"
                                   Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToVisConverter}, ConverterParameter=0}"/>
                <views:GamesListView DataContext="{Binding GamesListVm}"
                                     Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToVisConverter}, ConverterParameter=1}"/>
                <views:SettingsView DataContext="{Binding SettingsVm}"
                                    Visibility="{Binding SelectedTabIndex, Converter={StaticResource TabIndexToVisConverter}, ConverterParameter=2}"/>
            </Grid>
        </Grid>

        <!-- Game details overlay -->
        <views:GameDetailsView DataContext="{Binding GameDetailsVm}"
                               Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVisConverter}}"/>
    </Grid>
</Window>
