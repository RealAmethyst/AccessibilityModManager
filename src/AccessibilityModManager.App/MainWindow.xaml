<Window x:Class="AccessibilityModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AccessibilityModManager.App.ViewModels"
        xmlns:views="clr-namespace:AccessibilityModManager.App.Views"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Accessibility Mod Manager"
        Height="650" Width="900"
        MinHeight="400" MinWidth="600"
        AutomationProperties.Name="Accessibility Mod Manager">

    <Grid>
        <!-- Main tab navigation -->
        <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                    AutomationProperties.Name="Navigation"
                    Visibility="{Binding IsDetailsOpen, Converter={StaticResource InvertBoolToVisConverter}}">
            <TabItem Header="Plugins"
                     AutomationProperties.Name="Plugins">
                <views:PluginsView DataContext="{Binding PluginsVm}"/>
            </TabItem>
            <TabItem Header="Games"
                     AutomationProperties.Name="Games">
                <views:GamesListView DataContext="{Binding GamesListVm}"/>
            </TabItem>
            <TabItem Header="Settings"
                     AutomationProperties.Name="Settings">
                <views:SettingsView DataContext="{Binding SettingsVm}"/>
            </TabItem>
        </TabControl>

        <!-- Game details overlay -->
        <views:GameDetailsView DataContext="{Binding GameDetailsVm}"
                               Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVisConverter}}"/>
    </Grid>
</Window>
