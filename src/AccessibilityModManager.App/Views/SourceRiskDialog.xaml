<Window x:Class="AccessibilityModManager.App.Views.SourceRiskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AccessibilityModManager.App.ViewModels"
        xmlns:controls="clr-namespace:AccessibilityModManager.App.Controls"
        d:DataContext="{d:DesignInstance vm:SourceRiskDialogViewModel}"
        mc:Ignorable="d"
        Title="Add a source"
        Height="560" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        AutomationProperties.Name="Add a source">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Headline}"
                   FontSize="20" FontWeight="Bold"
                   TextWrapping="Wrap"
                   AutomationProperties.HeadingLevel="Level1"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding Summary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <!-- A read-only text box rather than a text block: WPF leaves text blocks out of the tab
             order, so a screen reader tabs straight past them and the warning is only reachable by
             object navigation. Typing is blocked but focus mode is kept, so it can be arrowed
             through line by line. Same pattern as the mod description and the author bio. -->
        <TextBox Grid.Row="2"
                 x:Name="RiskTextBox"
                 Text="{Binding RiskText, Mode=OneWay}"
                 controls:ReadOnlyText.IsEnabled="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                 BorderThickness="1"
                 Padding="10"
                 AutomationProperties.Name="What adding this source means"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="AddButton"
                    Content="I understand — add source"
                    AutomationProperties.Name="I understand, add source"
                    Click="Add_Click"
                    MinWidth="200"
                    Margin="0,0,8,0"/>
            <!-- Cancel is both the default and the escape, and takes focus on open: adding a source
                 has to be a deliberate act, so the safe answer is the one a stray Enter gives. -->
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Click="Cancel_Click"
                    IsCancel="True"
                    IsDefault="True"
                    AutomationProperties.Name="Cancel"
                    MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
