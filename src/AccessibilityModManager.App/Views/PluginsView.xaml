<UserControl x:Class="AccessibilityModManager.App.Views.PluginsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AccessibilityModManager.App.ViewModels"
             xmlns:controls="clr-namespace:AccessibilityModManager.App.Controls"
             d:DataContext="{d:DesignInstance vm:PluginsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AutomationProperties.Name="Developers">

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView Grid.Row="0"
                  x:Name="DevelopersList"
                  ItemsSource="{Binding Plugins}"
                  AutomationProperties.Name="Developers"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.InputBindings>
                <!-- Pressing Enter on a developer opens their list of mods. -->
                <KeyBinding Key="Enter"
                            Command="{Binding OpenDeveloperDetailsCommand}"
                            CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListView}}"/>
            </ListView.InputBindings>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <!-- Without this, the screen reader announces the bound type's full name
                         (e.g. "AccessibilityModManager.App.ViewModels.PluginItemViewModel"). -->
                    <Setter Property="AutomationProperties.Name" Value="{Binding Author}"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PluginItemViewModel}">
                    <Border Padding="12" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Author, Mode=OneWay}"
                                       FontSize="16" FontWeight="SemiBold"/>

                            <!-- The registry's per-plugin description used to sit here. It is
                                 listing metadata rather than anything the developer writes about
                                 themselves, and the row's AutomationProperties.Name is the author
                                 name, which overrides nested text anyway — so it was visible but
                                 never announced. The developer's own bio lives on their page. -->

                            <!-- Links -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Margin="0,4,0,0"
                                        Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisConverter}}">
                                <Button Content="Website"
                                        Command="{Binding OpenLinkCommand}"
                                        CommandParameter="{Binding Website}"
                                        Visibility="{Binding Website, Converter={StaticResource NullToCollapsedConverter}}"
                                        AutomationProperties.Name="{Binding Author, StringFormat='{}{0} website'}"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource LinkButtonStyle}"/>
                                <ItemsControl ItemsSource="{Binding Links}"
                                              Visibility="{Binding Links.Count, Converter={StaticResource CountToVisConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Key}"
                                                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                                    CommandParameter="{Binding Value}"
                                                    AutomationProperties.Name="{Binding Key}"
                                                    Margin="0,0,8,0"
                                                    Style="{StaticResource LinkButtonStyle}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Sources the user added. Kept separate from the developers list above, because "who
             wrote this" and "where did it come from" are different questions and merging them
             would hide the second one. -->
        <StackPanel Grid.Row="1"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasUserSources, Converter={StaticResource BoolToVisConverter}}">
            <TextBlock Text="Sources you added"
                       FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level2"
                       Margin="0,0,0,4"/>
            <ListView x:Name="UserSourcesList"
                      ItemsSource="{Binding UserSources}"
                      MaxHeight="140"
                      AutomationProperties.Name="Sources you added"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.InputBindings>
                    <KeyBinding Key="Delete"
                                Command="{Binding RemoveSourceCommand}"
                                CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                </ListView.InputBindings>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AnnouncementText}"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:UserSourceItemViewModel}">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Address}"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Remove"
                                    Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding DisplayName, StringFormat='Remove {0}'}"
                                    MinWidth="90"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- Adding a source: a labelled field and a button, right beside the list they change.
             A popup for one line of text would cost a screen-reader user a window to enter and
             leave for no benefit. -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- No access key. An underscore here makes Alt+A, and a screen reader announces that
                 accelerator after the label — it arrives as a stray "A" on the end of the field's
                 description. Nothing else in this app uses one. -->
            <Label Grid.Column="0"
                   Content="Add a source"
                   Target="{Binding ElementName=NewSourceAddressBox}"
                   AutomationProperties.Name="Add a source"
                   VerticalAlignment="Center"/>

            <TextBox Grid.Column="1"
                     x:Name="NewSourceAddressBox"
                     Text="{Binding NewSourceAddress, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"
                     AutomationProperties.Name="Add a source"
                     AutomationProperties.HelpText="Full https address of the author's index.json file"
                     VerticalAlignment="Center"
                     Margin="8,0,8,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddSourceCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="2"
                    Content="Add source"
                    Command="{Binding AddSourceCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"
                    AutomationProperties.Name="Add source"
                    MinWidth="110"/>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   controls:LiveRegion.Announcement="{Binding StatusAnnouncement}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   Margin="0,8,0,0"/>
    </Grid>
</UserControl>
