<UserControl x:Class="AccessibilityModManager.App.Views.GameDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AccessibilityModManager.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:GameDetailsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AutomationProperties.Name="Game details">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with back button -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Back"
                    Command="{Binding GoBackCommand}"
                    AutomationProperties.Name="Back"
                    Margin="0,0,12,0"/>
            <TextBlock Text="{Binding DisplayName}"
                       FontSize="24" FontWeight="Bold"
                       AutomationProperties.HeadingLevel="Level1"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Install path and folder button -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                <Run Text="Install path: "/>
                <Run Text="{Binding InstallPath, Mode=OneWay}" FontWeight="SemiBold"/>
            </TextBlock>
            <Button Content="Open Folder"
                    Command="{Binding OpenGameFolderCommand}"
                    AutomationProperties.Name="Open folder"/>
        </StackPanel>

        <!-- Channel selector -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Label Content="Channel"
                   Target="{Binding ElementName=ChannelSelector}"
                   VerticalAlignment="Center"/>
            <ComboBox x:Name="ChannelSelector"
                      SelectedValue="{Binding SelectedChannel}"
                      AutomationProperties.Name="Channel"
                      MinWidth="120">
                <ComboBoxItem Content="stable"/>
                <ComboBoxItem Content="beta"/>
            </ComboBox>
        </StackPanel>

        <!-- Mod releases grouped by plugin -->
        <ListView Grid.Row="3"
                  ItemsSource="{Binding ModGroups}"
                  AutomationProperties.Name="Available mods"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ModReleaseGroup}">
                    <Border Padding="12" Margin="0,0,0,8"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold">
                                <Run Text="Plugin: "/>
                                <Run Text="{Binding PluginId, Mode=OneWay}"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding InstalledVersion, Mode=OneWay, TargetNullValue='not installed',
                                     StringFormat='v{0}'}"
                                     Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </TextBlock>

                            <!-- Version selector -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <Label Content="Version"
                                       Target="{Binding ElementName=VersionCombo}"
                                       VerticalAlignment="Center"/>
                                <ComboBox x:Name="VersionCombo"
                                          ItemsSource="{Binding Releases}"
                                          SelectedItem="{Binding SelectedRelease}"
                                          DisplayMemberPath="Version"
                                          AutomationProperties.Name="Version"
                                          MinWidth="150"/>
                            </StackPanel>

                            <!-- Action buttons -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Install"
                                        Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource InvertBoolToVisConverter}}"
                                        AutomationProperties.Name="{Binding PluginId, StringFormat='Install {0}'}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Update"
                                        Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisConverter}}"
                                        AutomationProperties.Name="{Binding PluginId, StringFormat='Update {0}'}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Uninstall"
                                        Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisConverter}}"
                                        AutomationProperties.Name="{Binding PluginId, StringFormat='Uninstall {0}'}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Dependencies -->
        <Expander Grid.Row="4" Header="Dependencies"
                  AutomationProperties.Name="Dependencies"
                  Margin="0,8,0,0"
                  Visibility="{Binding Dependencies.Count, Converter={StaticResource CountToVisConverter}}">
            <ItemsControl ItemsSource="{Binding Dependencies}" Margin="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DependencyItemViewModel}">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock VerticalAlignment="Center" MinWidth="200">
                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding StatusText, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Content="Fix"
                                    Command="{Binding FixCommand}"
                                    Visibility="{Binding StatusKind, Converter={StaticResource NotInstalledToVisConverter}}"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Fix {0}'}"
                                    Margin="8,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <!-- Status -->
        <TextBlock Grid.Row="5"
                   Text="{Binding StatusMessage}"
                   AutomationProperties.LiveSetting="Assertive"
                   Margin="0,8,0,0"/>
    </Grid>
</UserControl>
