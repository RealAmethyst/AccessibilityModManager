<UserControl x:Class="AccessibilityModManager.App.Views.GameDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AccessibilityModManager.App.ViewModels"
             xmlns:controls="clr-namespace:AccessibilityModManager.App.Controls"
             d:DataContext="{d:DesignInstance vm:GameDetailsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             AutomationProperties.Name="Game details">

    <UserControl.InputBindings>
        <!-- Escape navigates back to the games list, just like the Back button. -->
        <KeyBinding Key="Escape" Command="{Binding GoBackCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with back button -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BackButton"
                    Content="Back"
                    Command="{Binding GoBackCommand}"
                    AutomationProperties.Name="Back"
                    Margin="0,0,12,0"/>
            <TextBlock Text="{Binding DisplayName}"
                       FontSize="24" FontWeight="Bold"
                       AutomationProperties.HeadingLevel="Level1"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Install path and per-game action buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                       Visibility="{Binding IsGameInstalled, Converter={StaticResource BoolToVisConverter}}">
                <Run Text="Install path: "/>
                <Run Text="{Binding InstallPath, Mode=OneWay}" FontWeight="SemiBold"/>
            </TextBlock>
            <Button Content="Play"
                    Command="{Binding PlayCommand}"
                    Visibility="{Binding AnyModInstalled, Converter={StaticResource BoolToVisConverter}}"
                    AutomationProperties.Name="{Binding DisplayName, StringFormat='Play {0}'}"
                    Margin="0,0,8,0"/>
            <Button Content="Open Folder"
                    Command="{Binding OpenGameFolderCommand}"
                    Visibility="{Binding IsGameInstalled, Converter={StaticResource BoolToVisConverter}}"
                    AutomationProperties.Name="Open folder"/>
        </StackPanel>

        <!-- Channel selector — only shown when more than one channel exists across releases. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12"
                    Visibility="{Binding HasMultipleChannels, Converter={StaticResource BoolToVisConverter}}">
            <Label Content="Channel"
                   Target="{Binding ElementName=ChannelSelector}"
                   VerticalAlignment="Center"/>
            <ComboBox x:Name="ChannelSelector"
                      SelectedItem="{Binding SelectedChannel}"
                      AutomationProperties.Name="Channel"
                      MinWidth="120">
                <sys:String>stable</sys:String>
                <sys:String>beta</sys:String>
            </ComboBox>
        </StackPanel>

        <!-- Mod release(s) for this game. FlatItemsControl is an ItemsControl that doesn't
             announce itself as a "list" to screen readers — the default ItemsControlAutomationPeer
             reports List as its role and NVDA reads it even when there's only one item. -->
        <controls:FlatItemsControl Grid.Row="3"
                                   x:Name="ModGroupsList"
                                   ItemsSource="{Binding ModGroups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ModReleaseGroup}">
                    <!-- ContentControl is a Control so it supports IsTabStop. Focusable + not
                         a Tab stop = the OperationCompleted handler can programmatically focus
                         it to announce the new state, while Tab skips straight to the controls
                         inside (version selector, action buttons). -->
                    <ContentControl Focusable="True" IsTabStop="False"
                                    AutomationProperties.Name="{Binding AnnouncementText}"
                                    Margin="0,0,0,8">
                    <Border Padding="12"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold">
                                <Run Text="{Binding ModName, Mode=OneWay}"/>
                                <Run Text=" by "/>
                                <Run Text="{Binding PluginId, Mode=OneWay}"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding InstalledVersion, Mode=OneWay, TargetNullValue='not installed',
                                     StringFormat='v{0}'}"
                                     Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </TextBlock>

                            <!-- Mod description (only when set). TextBox + input-blocking is
                                 the same pattern as ChangelogDialog: NVDA stays in focus mode
                                 so the user can arrow through the text, but the box can't
                                 actually be edited. Plain TextBlock would be invisible to the
                                 screen reader because the surrounding ContentControl's
                                 AutomationProperties.Name overrides nested elements. -->
                            <TextBox Grid.Row="1"
                                     Text="{Binding Description, Mode=OneWay}"
                                     IsReadOnly="False"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     Margin="0,8,0,0"
                                     Loaded="DescriptionBox_Loaded"
                                     PreviewTextInput="DescriptionBox_PreviewTextInput"
                                     PreviewKeyDown="DescriptionBox_PreviewKeyDown"
                                     AutomationProperties.Name="Mod description"
                                     Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisConverter}}"/>

                            <!-- Version selector -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Label Content="Version"
                                       Target="{Binding ElementName=VersionCombo}"
                                       VerticalAlignment="Center"/>
                                <ComboBox x:Name="VersionCombo"
                                          ItemsSource="{Binding Releases}"
                                          SelectedItem="{Binding SelectedRelease}"
                                          DisplayMemberPath="Version"
                                          AutomationProperties.Name="Version"
                                          MinWidth="150"/>
                            </StackPanel>

                            <!-- Action buttons -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Install"
                                        Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource InvertBoolToVisConverter}}"
                                        AutomationProperties.Name="{Binding InstallButtonName}"
                                        Margin="0,0,8,0"/>
                                <Button Content="{Binding UpdateButtonLabel}"
                                        Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisConverter}}"
                                        AutomationProperties.Name="{Binding UpdateButtonName}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Uninstall"
                                        Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisConverter}}"
                                        AutomationProperties.Name="{Binding UninstallButtonName}"
                                        Margin="0,0,8,0"/>
                                <Button Content="View changelog"
                                        Command="{Binding DataContext.ViewChangelogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding HasChangelog, Converter={StaticResource BoolToVisConverter}}"
                                        AutomationProperties.Name="View changelog for the selected release"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </ContentControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </controls:FlatItemsControl>

        <!-- Dependencies section removed per F7=B — auto-install handles missing deps as a
             step in the install flow now, so the user never has to manage them by hand. The
             grid still has a Row=4 reserved as a no-op spacer to keep status on Row=5. -->

        <!-- Status -->
        <TextBlock Grid.Row="5"
                   x:Name="StatusMessageBlock"
                   Text="{Binding StatusMessage}"
                   AutomationProperties.LiveSetting="Assertive"
                   Margin="0,8,0,0"/>
    </Grid>
</UserControl>
