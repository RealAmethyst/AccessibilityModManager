<UserControl x:Class="AccessibilityModManager.App.Views.DeveloperDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AccessibilityModManager.App.ViewModels"
             xmlns:controls="clr-namespace:AccessibilityModManager.App.Controls"
             d:DataContext="{d:DesignInstance vm:DeveloperDetailsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AutomationProperties.Name="Author details">

    <UserControl.InputBindings>
        <!-- Escape navigates back, mirroring GameDetailsView. -->
        <KeyBinding Key="Escape" Command="{Binding GoBackCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: Back + heading -->
            <RowDefinition Height="Auto"/>   <!-- 1: Bio -->
            <RowDefinition Height="*"/>      <!-- 2: this developer's mods -->
            <RowDefinition Height="Auto"/>   <!-- 3: social links -->
            <RowDefinition Height="Auto"/>   <!-- 4: status -->
        </Grid.RowDefinitions>

        <!-- Header with back button -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BackButton"
                    Content="Back"
                    Command="{Binding GoBackCommand}"
                    AutomationProperties.Name="{Binding DisplayName, StringFormat='Back. Currently viewing {0}'}"
                    Margin="0,0,12,0"/>
            <TextBlock x:Name="HeadingText"
                       Text="{Binding DisplayName}"
                       FontSize="24" FontWeight="Bold"
                       AutomationProperties.HeadingLevel="Level1"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- The developer's bio, and the reason this page was rebuilt: it used to be a TextBlock,
             which WPF leaves non-focusable and out of the tab order, so the only way to read it was
             object navigation. A TextBox kept nominally editable (with every edit swallowed by
             ReadOnlyText) keeps NVDA in focus mode, so the caret arrows through it line by line.
             Hidden entirely when the developer hasn't written one — no placeholder. -->
        <TextBox Grid.Row="1"
                 Text="{Binding Bio, Mode=OneWay}"
                 controls:ReadOnlyText.IsEnabled="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="0"
                 Margin="0,0,0,12"
                 AutomationProperties.Name="Bio"
                 Visibility="{Binding HasBio, Converter={StaticResource BoolToVisConverter}}"/>

        <!-- List of mods this developer makes (one per supported game) -->
        <ListView Grid.Row="2"
                  x:Name="ModsList"
                  ItemsSource="{Binding Mods}"
                  AutomationProperties.Name="Mods"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.InputBindings>
                <!-- Pressing Enter on a mod opens the Game Details view for that game. -->
                <KeyBinding Key="Enter"
                            Command="{Binding OpenModCommand}"
                            CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListView}}"/>
            </ListView.InputBindings>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AnnouncementText}"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DeveloperModItemViewModel}">
                    <Border Padding="12" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       FontSize="16" FontWeight="SemiBold">
                                <Run Text="{Binding ModName, Mode=OneWay}"/>
                                <Run Text=" for "/>
                                <Run Text="{Binding GameDisplayName, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Social links (each hides when its URL isn't set). Declared AFTER the mods list on
             purpose: WPF tab order follows declaration order, not Grid.Row, so declaring these
             earlier would put five link buttons between the bio and the mods no matter which row
             they were drawn in. Bio, then mods, then links. -->
        <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Website"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="{Binding WebsiteUrl}"
                    AutomationProperties.Name="Open author website"
                    Margin="0,0,8,8"
                    Visibility="{Binding HasWebsite, Converter={StaticResource BoolToVisConverter}}"/>
            <Button Content="Discord"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="{Binding DiscordUrl}"
                    AutomationProperties.Name="Open author Discord"
                    Margin="0,0,8,8"
                    Visibility="{Binding HasDiscord, Converter={StaticResource BoolToVisConverter}}"/>
            <Button Content="Patreon"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="{Binding PatreonUrl}"
                    AutomationProperties.Name="Open author Patreon"
                    Margin="0,0,8,8"
                    Visibility="{Binding HasPatreon, Converter={StaticResource BoolToVisConverter}}"/>
            <Button Content="GitHub"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="{Binding GitHubUrl}"
                    AutomationProperties.Name="Open author GitHub"
                    Margin="0,0,8,8"
                    Visibility="{Binding HasGitHub, Converter={StaticResource BoolToVisConverter}}"/>
            <Button Content="Donate"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="{Binding DonationUrl}"
                    AutomationProperties.Name="Open author donation page"
                    Margin="0,0,8,8"
                    Visibility="{Binding HasDonation, Converter={StaticResource BoolToVisConverter}}"/>
        </WrapPanel>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   controls:LiveRegion.Announcement="{Binding StatusAnnouncement}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   Margin="0,8,0,0"/>
    </Grid>
</UserControl>
