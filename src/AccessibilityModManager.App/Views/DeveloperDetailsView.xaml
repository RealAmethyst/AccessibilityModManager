<UserControl x:Class="AccessibilityModManager.App.Views.DeveloperDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AccessibilityModManager.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:DeveloperDetailsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AutomationProperties.Name="Author details">

    <UserControl.InputBindings>
        <!-- Escape navigates back, mirroring GameDetailsView. -->
        <KeyBinding Key="Escape" Command="{Binding GoBackCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with back button -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BackButton"
                    Content="Back"
                    Command="{Binding GoBackCommand}"
                    AutomationProperties.Name="{Binding DisplayName, StringFormat='Back. Currently viewing {0}'}"
                    Margin="0,0,12,0"/>
            <TextBlock x:Name="HeadingText"
                       Text="{Binding DisplayName}"
                       FontSize="24" FontWeight="Bold"
                       AutomationProperties.HeadingLevel="Level1"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Bio (only when author info is present) -->
        <TextBlock Grid.Row="1"
                   Text="{Binding Bio}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="{Binding HasBio, Converter={StaticResource BoolToVisConverter}}"/>

        <!-- Social links (each link button hides when its URL isn't set) -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Website"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="{Binding WebsiteUrl}"
                    AutomationProperties.Name="Open author website"
                    Margin="0,0,8,8"
                    Visibility="{Binding HasWebsite, Converter={StaticResource BoolToVisConverter}}"/>
            <Button Content="Discord"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="{Binding DiscordUrl}"
                    AutomationProperties.Name="Open author Discord"
                    Margin="0,0,8,8"
                    Visibility="{Binding HasDiscord, Converter={StaticResource BoolToVisConverter}}"/>
            <Button Content="Patreon"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="{Binding PatreonUrl}"
                    AutomationProperties.Name="Open author Patreon"
                    Margin="0,0,8,8"
                    Visibility="{Binding HasPatreon, Converter={StaticResource BoolToVisConverter}}"/>
            <Button Content="GitHub"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="{Binding GitHubUrl}"
                    AutomationProperties.Name="Open author GitHub"
                    Margin="0,0,8,8"
                    Visibility="{Binding HasGitHub, Converter={StaticResource BoolToVisConverter}}"/>
            <Button Content="Donate"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="{Binding DonationUrl}"
                    AutomationProperties.Name="Open author donation page"
                    Margin="0,0,8,8"
                    Visibility="{Binding HasDonation, Converter={StaticResource BoolToVisConverter}}"/>
        </WrapPanel>

        <!-- List of mods this developer makes (one per supported game) -->
        <ListView Grid.Row="3"
                  x:Name="ModsList"
                  ItemsSource="{Binding Mods}"
                  AutomationProperties.Name="Mods"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.InputBindings>
                <!-- Pressing Enter on a mod opens the Game Details view for that game. -->
                <KeyBinding Key="Enter"
                            Command="{Binding OpenModCommand}"
                            CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListView}}"/>
            </ListView.InputBindings>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AnnouncementText}"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DeveloperModItemViewModel}">
                    <Border Padding="12" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       FontSize="16" FontWeight="SemiBold">
                                <Run Text="{Binding ModName, Mode=OneWay}"/>
                                <Run Text=" for "/>
                                <Run Text="{Binding GameDisplayName, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   AutomationProperties.LiveSetting="Polite"
                   Margin="0,8,0,0"/>
    </Grid>
</UserControl>
