<UserControl x:Class="AccessibilityModManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AccessibilityModManager.App.ViewModels"
             xmlns:controls="clr-namespace:AccessibilityModManager.App.Controls"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             AutomationProperties.Name="Settings">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,8,16,16" MaxWidth="600" HorizontalAlignment="Left">

            <!-- The registry URL is hardcoded and not user-editable on purpose; it's the trust
                 anchor for signature verification. -->

            <Label Content="Default Channel"
                   Target="{Binding ElementName=ChannelCombo}"
                   AutomationProperties.Name="Default channel"/>
            <ComboBox x:Name="ChannelCombo"
                      SelectedItem="{Binding DefaultChannel}"
                      AutomationProperties.Name="Default channel"
                      Margin="0,4,0,16">
                <sys:String>stable</sys:String>
                <sys:String>beta</sys:String>
            </ComboBox>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Save Settings"
                        Command="{Binding SaveSettingsCommand}"
                        AutomationProperties.Name="Save"
                        Margin="0,0,8,0"/>
                <Button Content="Open Logs"
                        Command="{Binding OpenLogsCommand}"
                        AutomationProperties.Name="Open logs"/>
            </StackPanel>

            <!-- Patreon section. Some mod authors offer beta builds to their patrons; sign
                 in here so the manager can read your tier membership and unlock those
                 builds. The manager only ever reads memberships — no posting, no profile
                 access beyond your name + email. -->
            <TextBlock Text="Patreon"
                       FontSize="16" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level2"
                       Margin="0,8,0,4"/>
            <!-- The standing account summary, not an event. Signing in changes this AND the status
                 line below; announcing both said the same news twice. The status line is the one
                 tied to the action the user just took. -->
            <TextBlock Text="{Binding PatreonStatusText}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="{Binding SignInButtonText}"
                        Command="{Binding SignInOrOutOfPatreonCommand}"
                        IsEnabled="{Binding PatreonBusy, Converter={StaticResource InvertBoolConverter}}"
                        AutomationProperties.Name="{Binding SignInButtonText}"
                        Margin="0,0,8,0"
                        MinWidth="160"/>
                <Button Content="Refresh status"
                        Command="{Binding RefreshPatreonStatusCommand}"
                        IsEnabled="{Binding IsSignedInToPatreon}"
                        Visibility="{Binding IsSignedInToPatreon, Converter={StaticResource BoolToVisConverter}}"
                        AutomationProperties.Name="Refresh Patreon entitlement status"/>
            </StackPanel>

            <TextBlock controls:LiveRegion.Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
