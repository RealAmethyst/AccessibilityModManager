<Window x:Class="AccessibilityModManager.App.Views.ManualDependencyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Manual install required"
        Height="320" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        AutomationProperties.Name="Manual install required">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeadingText"
                   FontSize="18" FontWeight="Bold"
                   TextWrapping="Wrap"
                   AutomationProperties.HeadingLevel="Level1"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="This mod needs a component the manager can't install for you. The download page has been opened in your browser. Install the component, then come back and click Continue."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2"
                   Text="Download URL:"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"/>

        <TextBox Grid.Row="3"
                 x:Name="UrlBox"
                 IsReadOnly="True"
                 AcceptsReturn="False"
                 TextWrapping="Wrap"
                 BorderThickness="1"
                 Padding="6"
                 FontFamily="Consolas"
                 FontSize="12"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Download URL"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Open download page"
                    Click="OpenUrl_Click"
                    AutomationProperties.Name="Open download page in browser"
                    MinWidth="180"
                    Margin="0,0,8,0"/>
            <Button Content="Continue"
                    Click="Continue_Click"
                    AutomationProperties.Name="Continue with the install"
                    MinWidth="100"
                    Margin="0,0,8,0"/>
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Click="Cancel_Click"
                    IsCancel="True"
                    IsDefault="True"
                    AutomationProperties.Name="Cancel install"
                    MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
