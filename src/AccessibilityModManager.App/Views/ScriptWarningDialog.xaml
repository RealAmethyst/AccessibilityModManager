<Window x:Class="AccessibilityModManager.App.Views.ScriptWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AccessibilityModManager.App.ViewModels"
        xmlns:controls="clr-namespace:AccessibilityModManager.App.Controls"
        d:DataContext="{d:DesignInstance vm:ScriptWarningDialogViewModel}"
        mc:Ignorable="d"
        Title="Mod includes scripts"
        Height="600" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        AutomationProperties.Name="Mod includes scripts">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Headline}"
                   FontSize="20" FontWeight="Bold"
                   TextWrapping="Wrap"
                   AutomationProperties.HeadingLevel="Level1"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding Subheading}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2"
                   Text="What this mod will run on your machine:"
                   FontWeight="SemiBold"
                   AutomationProperties.HeadingLevel="Level2"
                   Margin="0,0,0,8"/>

        <ListBox Grid.Row="3"
                 ItemsSource="{Binding Hooks}"
                 BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                 BorderThickness="1"
                 HorizontalContentAlignment="Stretch"
                 AutomationProperties.Name="Scripts in this mod">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AnnouncementText}"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="Margin" Value="2"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ScriptHookViewModel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding HookHeading}"
                                       FontWeight="Bold"
                                       FontSize="14"/>
                            <TextBlock Text="  (needs admin)"
                                       Foreground="DarkRed"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Visibility="{Binding NeedsAdminVisibility}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ExecutableLine}"
                                   FontFamily="Consolas"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding WhatLine}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding WhyLine}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding ModifiesLine}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding FailureLine}"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="4"
                   Text="Only proceed if you trust the author. Cancel will abort without making any changes."
                   TextWrapping="Wrap"
                   FontStyle="Italic"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   Margin="0,12,0,0"/>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="ProceedButton"
                    Content="{Binding ProceedButtonText}"
                    AutomationProperties.Name="{Binding ProceedButtonText}"
                    Click="Proceed_Click"
                    MinWidth="180"
                    Margin="0,0,8,0"/>
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Click="Cancel_Click"
                    IsCancel="True"
                    IsDefault="True"
                    AutomationProperties.Name="Cancel"
                    MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
