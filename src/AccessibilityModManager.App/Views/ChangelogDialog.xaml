<Window x:Class="AccessibilityModManager.App.Views.ChangelogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AccessibilityModManager.App.Controls"
        mc:Ignorable="d"
        Title="Changelog"
        Height="600" Width="640"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="Changelog">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeaderText"
                   FontSize="20" FontWeight="Bold"
                   AutomationProperties.HeadingLevel="Level1"
                   Margin="0,0,0,12"/>

        <!-- Editable TextBox with blocked input — keeps NVDA in focus mode so arrow keys
             move the caret line by line. Read-only edits get punted to NVDA's browse mode
             which doesn't navigate WPF content. -->
        <TextBox Grid.Row="1"
                 x:Name="DocumentViewer"
                 controls:ReadOnlyText.IsEnabled="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="13"
                 AutomationProperties.Name="Changelog content"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OpenInBrowserButton"
                    Content="Open in browser"
                    Click="OpenInBrowser_Click"
                    AutomationProperties.Name="Open changelog in browser"
                    Margin="0,0,8,0" MinWidth="140"
                    Visibility="Collapsed"/>
            <Button Content="Close"
                    Click="Close_Click"
                    IsCancel="True"
                    IsDefault="True"
                    AutomationProperties.Name="Close changelog"
                    MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
