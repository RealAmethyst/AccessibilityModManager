<UserControl x:Class="AccessibilityModManager.App.Views.GamesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AccessibilityModManager.App.ViewModels"
             xmlns:controls="clr-namespace:AccessibilityModManager.App.Controls"
             d:DataContext="{d:DesignInstance vm:GamesListViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AutomationProperties.Name="Mods">

    <Grid Margin="16,8,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.RowSpan="2"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,0,1,0"
                Padding="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel KeyboardNavigation.DirectionalNavigation="Contained">
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Filters"
                                   FontSize="16" FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level2"/>
                        <Button DockPanel.Dock="Right"
                                Content="Clear"
                                Command="{Binding ClearFiltersCommand}"
                                IsEnabled="{Binding HasAnyFilterSelected}"
                                AutomationProperties.Name="Clear all filters"/>
                    </DockPanel>

                    <TextBlock Text="{Binding MatchCountText}"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Margin="0,0,0,8"/>

                    <Expander Header="Tags"
                              IsExpanded="True"
                              AutomationProperties.Name="Tag filters">
                        <controls:FlatItemsControl ItemsSource="{Binding TagFilters}"
                                                   KeyboardNavigation.DirectionalNavigation="Contained"
                                                   Margin="0,4,0,0">
                            <controls:FlatItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              Content="{Binding Label}"
                                              AutomationProperties.Name="{Binding Label}"
                                              Margin="0,2"/>
                                </DataTemplate>
                            </controls:FlatItemsControl.ItemTemplate>
                        </controls:FlatItemsControl>
                    </Expander>

                    <Expander Header="Languages"
                              IsExpanded="True"
                              AutomationProperties.Name="Language filters"
                              Margin="0,8,0,0">
                        <controls:FlatItemsControl ItemsSource="{Binding LanguageFilters}"
                                                   KeyboardNavigation.DirectionalNavigation="Contained"
                                                   Margin="0,4,0,0">
                            <controls:FlatItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              Content="{Binding Label}"
                                              AutomationProperties.Name="{Binding Label}"
                                              Margin="0,2"/>
                                </DataTemplate>
                            </controls:FlatItemsControl.ItemTemplate>
                        </controls:FlatItemsControl>
                    </Expander>

                    <Expander Header="Authors"
                              IsExpanded="True"
                              AutomationProperties.Name="Author filters"
                              Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="No authors loaded yet. Enable plugin authors on the Authors tab."
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding AuthorFilters.Count, Converter={StaticResource EmptyCountToVisConverter}}"/>
                            <controls:FlatItemsControl ItemsSource="{Binding AuthorFilters}"
                                                       KeyboardNavigation.DirectionalNavigation="Contained"
                                                       Margin="0,4,0,0">
                                <controls:FlatItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  Content="{Binding PluginId}"
                                                  AutomationProperties.Name="{Binding PluginId}"
                                                  Margin="0,2"/>
                                    </DataTemplate>
                                </controls:FlatItemsControl.ItemTemplate>
                            </controls:FlatItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ListView Grid.Row="0" Grid.Column="1"
                  x:Name="GamesList"
                  Margin="12,0,0,0"
                  ItemsSource="{Binding Mods}"
                  AutomationProperties.Name="Mods"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.InputBindings>
                <!-- Pressing Enter on the focused mod opens that mod's details. -->
                <KeyBinding Key="Enter"
                            Command="{Binding OpenGameDetailsCommand}"
                            CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListView}}"/>
            </ListView.InputBindings>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <!-- Same announcement format as Developer Details: "ModName for GameName, status". -->
                    <Setter Property="AutomationProperties.Name" Value="{Binding AnnouncementText}"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ModItemViewModel}">
                    <Border Padding="12" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       FontSize="16" FontWeight="SemiBold">
                                <Run Text="{Binding ModName, Mode=OneWay}"/>
                                <Run Text=" for "/>
                                <Run Text="{Binding GameDisplayName, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>

                            <!-- Per-mod folder helpers. Multiple mods sharing a game produce
                                 duplicate buttons — they all act on the same game folder. -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Open Folder"
                                        Command="{Binding DataContext.OpenGameFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsDetected, Converter={StaticResource BoolToVisConverter}}"
                                        AutomationProperties.Name="{Binding GameDisplayName, StringFormat='{}{0} folder'}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Browse for Folder"
                                        Command="{Binding DataContext.BrowseForGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsDetected, Converter={StaticResource InvertBoolToVisConverter}}"
                                        AutomationProperties.Name="{Binding GameDisplayName, StringFormat='Browse for {0}'}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1" Grid.Column="1"
                   Text="{Binding StatusMessage}"
                   AutomationProperties.LiveSetting="Polite"
                   Margin="12,8,0,0"/>
    </Grid>
</UserControl>
