<Window x:Class="AccessibilityModManager.App.Views.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AccessibilityModManager.App.ViewModels"
        d:DataContext="{d:DesignInstance vm:ProgressDialogViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="320" Width="560"
        MinHeight="200" MinWidth="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        AutomationProperties.Name="Progress">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Message}"
                   TextWrapping="Wrap"
                   FontSize="14"
                   AutomationProperties.LiveSetting="Polite"
                   Margin="0,0,0,12"/>

        <ProgressBar Grid.Row="1"
                     Value="{Binding Percentage}"
                     Minimum="0" Maximum="100"
                     Height="24"
                     AutomationProperties.Name="Progress"
                     Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2"
                   Text="{Binding StepDescription}"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   AutomationProperties.LiveSetting="Polite"/>

        <TextBlock Grid.Row="3"
                   Text="{Binding ScriptStatusHeader}"
                   FontWeight="SemiBold"
                   AutomationProperties.HeadingLevel="Level2"
                   AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding IsScriptRunning, Converter={StaticResource BoolToVisConverter}}"
                   Margin="0,12,0,4"/>

        <TextBox Grid.Row="4"
                 x:Name="OutputBox"
                 Text="{Binding ScriptOutput, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextChanged="OutputBox_TextChanged"
                 AutomationProperties.Name="Script output"
                 AutomationProperties.LiveSetting="Polite"
                 Visibility="{Binding IsScriptRunning, Converter={StaticResource BoolToVisConverter}}"/>

        <Button Grid.Row="5"
                Content="Cancel"
                Command="{Binding CancelCommand}"
                IsEnabled="{Binding IsCancellable}"
                AutomationProperties.Name="Cancel"
                HorizontalAlignment="Right"
                MinWidth="80"
                Margin="0,12,0,0"/>
    </Grid>
</Window>
