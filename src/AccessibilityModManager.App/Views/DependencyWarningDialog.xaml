<Window x:Class="AccessibilityModManager.App.Views.DependencyWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AccessibilityModManager.App.ViewModels"
        d:DataContext="{d:DesignInstance vm:DependencyWarningDialogViewModel}"
        mc:Ignorable="d"
        Title="Dependencies"
        Height="520" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        AutomationProperties.Name="Dependencies">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Headline}"
                   FontSize="20" FontWeight="Bold"
                   TextWrapping="Wrap"
                   AutomationProperties.HeadingLevel="Level1"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding Subheading}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2"
                   Text="Components to install:"
                   FontWeight="SemiBold"
                   AutomationProperties.HeadingLevel="Level2"
                   Margin="0,0,0,8"/>

        <ListBox Grid.Row="3"
                 ItemsSource="{Binding Items}"
                 BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                 BorderThickness="1"
                 HorizontalContentAlignment="Stretch"
                 AutomationProperties.Name="Dependencies in this install">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AnnouncementText}"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="Margin" Value="2"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DependencyPromptItemViewModel}">
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanChangeSelection}"
                              AutomationProperties.Name="{Binding AnnouncementText}"
                              HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Heading}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="  (needs administrator)"
                                           Foreground="DarkRed"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Visibility="{Binding NeedsAdminVisibility}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KindLine}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding DownloadLine}" FontFamily="Consolas" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="ProceedButton"
                    Content="Continue"
                    AutomationProperties.Name="Continue with selected dependencies"
                    Click="Proceed_Click"
                    MinWidth="180"
                    Margin="0,0,8,0"/>
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Click="Cancel_Click"
                    IsCancel="True"
                    IsDefault="True"
                    AutomationProperties.Name="Cancel"
                    MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
