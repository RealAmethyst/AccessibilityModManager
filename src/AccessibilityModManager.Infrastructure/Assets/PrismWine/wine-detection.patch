 inline bool running_under_wine() noexcept {
   auto *const ntdll = GetModuleHandle(_T("ntdll.dll"));
-  return ntdll != nullptr &&
-         GetProcAddress(ntdll, "wine_get_version") != nullptr;
+  if (ntdll != nullptr && GetProcAddress(ntdll, "wine_get_version") != nullptr)
+    return true;
+  // Wine-XIV hides version exports to preserve the game's Windows licensing.
+  // This Wine-specific path API remains available with HideWineExports enabled.
+  auto *const kernel = GetModuleHandle(_T("kernel32.dll"));
+  return kernel != nullptr &&
+         GetProcAddress(kernel, "wine_get_unix_file_name") != nullptr;
 }
 
