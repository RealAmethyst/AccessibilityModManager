<Window x:Class="AccessibilityModManager.AuthorTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AccessibilityModManager.AuthorTool.ViewModels"
        xmlns:views="clr-namespace:AccessibilityModManager.AuthorTool.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Height="700" Width="1000"
        MinHeight="500" MinWidth="800"
        AutomationProperties.Name="Plugin Index Author">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ProjectPickerViewModel}">
            <views:ProjectPickerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IndexEditorViewModel}">
            <views:IndexEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegistryAdminViewModel}">
            <views:RegistryAdminView/>
        </DataTemplate>
    </Window.Resources>

    <ContentPresenter Content="{Binding CurrentView}"/>
</Window>
