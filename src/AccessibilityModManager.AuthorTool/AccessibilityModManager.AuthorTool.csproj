<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AccessibilityModManager.Core\AccessibilityModManager.Core.csproj" />
    <ProjectReference Include="..\AccessibilityModManager.Infrastructure\AccessibilityModManager.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SSH.NET" Version="2024.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- For one P/Invoke: the durable file replace the publishing journal depends on. .NET's
         File.Move does not pass MOVEFILE_WRITE_THROUGH, so a flushed file can still be followed by
         a lost rename. LibraryImport's generated marshalling requires this switch. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AccessibilityModManager.AuthorTool</RootNamespace>
    <AssemblyName>AccessibilityModManager.AuthorTool</AssemblyName>
    <Version>0.24.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RegistryAdmin)' == 'true'">
    <DefineConstants>$(DefineConstants);REGISTRY_ADMIN</DefineConstants>
  </PropertyGroup>

</Project>
