<UserControl x:Class="AccessibilityModManager.AuthorTool.Views.ProjectPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AccessibilityModManager.AuthorTool.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProjectPickerViewModel}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Plugin Index Author"
                   FontSize="28" FontWeight="Bold"
                   AutomationProperties.HeadingLevel="Level1"
                   Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1"
                   Text="Pick a project to edit, or open a new one."
                   Margin="0,0,0,16"/>

        <Grid Grid.Row="2" Visibility="{Binding IsShowingGitHubRepos, Converter={StaticResource InvertBoolToVisConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Recent projects"
                           FontSize="18" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level2"
                           Margin="0,0,0,8"/>

                <ListBox Grid.Row="1"
                         x:Name="RecentList"
                         ItemsSource="{Binding RecentProjects}"
                         SelectedItem="{Binding SelectedRecent}"
                         AutomationProperties.Name="Recent projects"
                         MinHeight="200"
                         MouseDoubleClick="RecentList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#888"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="2"
                        Content="Open selected"
                        Command="{Binding OpenRecentCommand}"
                        AutomationProperties.Name="Open selected recent project"
                        IsDefault="True"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"/>
            </Grid>

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Add new project"
                           FontSize="18" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level2"
                           Margin="0,0,0,8"/>

                <Button Grid.Row="1"
                        Content="Pick from your GitHub repos"
                        Command="{Binding ListGitHubReposCommand}"
                        AutomationProperties.Name="Pick from your GitHub repos"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"/>

                <Button Grid.Row="2"
                        Content="Open local folder"
                        Command="{Binding OpenLocalFolderCommand}"
                        AutomationProperties.Name="Open a local folder"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"/>

                <TextBlock Grid.Row="3"
                           Text="If the chosen folder has no index.json yet, the tool will ask for a plugin ID and create a starter file."
                           TextWrapping="Wrap"
                           Foreground="#666"
                           Margin="0,8,0,4"/>

                <Button Grid.Row="4"
                        x:Name="AdminButton"
                        Content="Registry admin..."
                        Command="{Binding OpenAdminCommand}"
                        AutomationProperties.Name="Open the registry admin view"
                        HorizontalAlignment="Left"
                        Margin="0,16,0,0"
                        Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Visibility="{Binding IsShowingGitHubRepos, Converter={StaticResource BoolToVisConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Pick one of your GitHub repos"
                       FontSize="18" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level2"
                       Margin="0,0,0,8"/>

            <ListBox Grid.Row="1"
                     x:Name="GitHubReposList"
                     ItemsSource="{Binding GitHubRepos}"
                     SelectedItem="{Binding SelectedGitHubRepo}"
                     AutomationProperties.Name="Your GitHub repos"
                     MinHeight="300"
                     MouseDoubleClick="GitHubReposList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding NameWithOwner}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding NameWithOwner}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#888"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Use this repo"
                        Command="{Binding UseGitHubRepoCommand}"
                        AutomationProperties.Name="Use this repo"
                        IsDefault="True"
                        Margin="0,0,8,0"/>
                <Button Content="Back"
                        Command="{Binding BackFromGitHubListCommand}"
                        AutomationProperties.Name="Back to project picker"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   AutomationProperties.LiveSetting="Polite"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}"/>
    </Grid>
</UserControl>
