<UserControl x:Class="AccessibilityModManager.AuthorTool.Views.RegistryAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AccessibilityModManager.AuthorTool.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RegistryAdminViewModel}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Left"
                    Content="Back"
                    Command="{Binding GoBackCommand}"
                    AutomationProperties.Name="Back to project picker"
                    Margin="0,0,12,0"/>
            <TextBlock Text="Registry admin"
                       FontSize="22" FontWeight="Bold"
                       AutomationProperties.HeadingLevel="Level1"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Repo + key pickers -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Registry repo:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding RegistryRepoPath, Mode=OneWay}"
                     IsReadOnly="True"
                     AutomationProperties.Name="Local registry repo path (auto-cloned)"/>
            <Button Grid.Row="0" Grid.Column="2"
                    Content="Refresh"
                    Command="{Binding RefreshRepoCommand}"
                    AutomationProperties.Name="Re-clone or pull the registry repo"
                    Margin="8,0,0,0"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Private key (PEM):" VerticalAlignment="Center" Margin="0,8,0,0"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding PrivateKeyPath, Mode=OneWay}"
                     IsReadOnly="True"
                     AutomationProperties.Name="Private key path"
                     Margin="0,8,0,0"/>
            <Button Grid.Row="1" Grid.Column="2"
                    Content="Pick..."
                    Command="{Binding PickPrivateKeyCommand}"
                    AutomationProperties.Name="Pick private key"
                    Margin="8,8,0,0"/>
        </Grid>

        <!-- JSON editor -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right"
                        Content="Save JSON"
                        Command="{Binding SaveJsonCommand}"
                        AutomationProperties.Name="Save edited registry JSON"/>
                <TextBlock VerticalAlignment="Center">
                    <Run Text="plugin-registry.json " FontWeight="SemiBold"/>
                    <Run Text="(unsaved)" Foreground="#B00"
                         d:Text="(unsaved)"/>
                </TextBlock>
            </DockPanel>

            <!-- Real fields for the values that actually get edited; they write straight into
                 the JSON below, so Save / Sign / Publish are unchanged. Born from the outage:
                 re-pointing the index URL used to mean hand-editing raw JSON in a screen reader. -->
            <Grid Grid.Row="1" Margin="0,0,0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Registry version:" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding FieldRegistryVersion, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Registry version"
                         AutomationProperties.HelpText="Must be raised on every published change. Publish blocks if it wasn't."
                         Margin="0,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Plugin:" VerticalAlignment="Center" Margin="0,2"/>
                <ComboBox Grid.Row="1" Grid.Column="1"
                          ItemsSource="{Binding PluginIds}"
                          SelectedItem="{Binding SelectedPluginId}"
                          AutomationProperties.Name="Plugin the fields below edit"
                          Margin="0,2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Repo index URL:" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding FieldRepoIndexUrl, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Repo index URL"
                         AutomationProperties.HelpText="The https address of this plugin's index.json. Applies to the JSON once it's a complete https address."
                         FontFamily="Consolas"
                         Margin="0,2"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Website:" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding FieldWebsite, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Plugin website"
                         AutomationProperties.HelpText="Optional https address shown to users. Leave empty to remove it."
                         Margin="0,2"/>
            </Grid>

            <TextBox Grid.Row="2"
                     x:Name="RegistryJsonBox"
                     Text="{Binding RegistryJsonContent, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12"
                     AutomationProperties.Name="Registry JSON editor"
                     MinHeight="180"/>
        </Grid>

        <!-- Password + actions -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Key password:" VerticalAlignment="Center"/>
            <PasswordBox Grid.Column="1"
                         x:Name="PasswordBox"
                         AutomationProperties.Name="Private key password"/>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Sign"
                        Click="Sign_Click"
                        AutomationProperties.Name="Sign the registry"
                        Margin="0,0,8,0" MinWidth="80"/>
                <Button Content="Commit + push"
                        Command="{Binding CommitAndPushCommand}"
                        AutomationProperties.Name="Commit and push registry changes"
                        Margin="0,0,8,0" MinWidth="120"/>
                <Button Content="Publish"
                        Command="{Binding PublishReleaseCommand}"
                        AutomationProperties.Name="Publish the signed registry to your server"
                        AutomationProperties.HelpText="Uploads the registry and its signature to your server and switches them live. This is what every manager reads."
                        MinWidth="130"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}"
                       AutomationProperties.LiveSetting="Polite"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
