<Window x:Class="AccessibilityModManager.AuthorTool.Views.ServerUploadSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AccessibilityModManager.AuthorTool.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ServerUploadSettingsViewModel}"
        Title="Server upload settings"
        Height="640" Width="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AutomationProperties.Name="Server upload settings">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Server upload settings"
                   FontSize="20" FontWeight="Bold"
                   AutomationProperties.HeadingLevel="Level1"
                   Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1"
                   Text="Once configured, every Patreon-gated release you save will be SFTP-uploaded to your server using your existing SSH key. Leave Host empty to disable auto-upload."
                   TextWrapping="Wrap"
                   Foreground="#666"
                   Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Server host:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         x:Name="HostBox"
                         Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Server host"
                         AutomationProperties.HelpText="Hostname your VPS responds to."
                         Margin="0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Server user:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding User, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Server user"
                         AutomationProperties.HelpText="The Linux user on your VPS that owns the releases folder."
                         Margin="0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Host key fingerprint:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding HostKeyFingerprint, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Server host key fingerprint"
                         AutomationProperties.HelpText="Run Test connection to see the server's SHA256 fingerprint. Verify it out-of-band before pasting it here."
                         FontFamily="Consolas"
                         Margin="0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="SSH private key path:" VerticalAlignment="Center" Margin="0,4"/>
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="SSH private key path"
                             AutomationProperties.HelpText="Path to your OpenSSH private key file."
                             FontFamily="Consolas"/>
                    <Button Grid.Column="1"
                            Content="Browse..."
                            Click="BrowsePrivateKey_Click"
                            AutomationProperties.Name="Browse for SSH private key file"
                            MinWidth="90"
                            Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Key passphrase:" VerticalAlignment="Center" Margin="0,4"/>
                <PasswordBox Grid.Row="4" Grid.Column="1"
                             x:Name="PassphraseBox"
                             AutomationProperties.Name="SSH key passphrase"
                             AutomationProperties.HelpText="Leave empty if your key has no passphrase."
                             Margin="0,4"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Remote releases path:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="5" Grid.Column="1"
                         Text="{Binding RemoteBasePath, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Remote releases base path"
                         AutomationProperties.HelpText="Absolute POSIX path on the VPS where each game and version subfolder lives."
                         FontFamily="Consolas"
                         Margin="0,4"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Remote catalog root:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="6" Grid.Column="1"
                         Text="{Binding RemoteCatalogRoot, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Remote catalog root"
                         AutomationProperties.HelpText="Absolute POSIX path of the registry web root on the VPS. The registry pair and each plugin's index.json publish here."
                         FontFamily="Consolas"
                         Margin="0,4"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Public base URL:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="7" Grid.Column="1"
                         Text="{Binding PublicBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Public download base URL"
                         AutomationProperties.HelpText="HTTPS URL the manager downloads from. Must start with https://."
                         Margin="0,4"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="SFTP port:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="8" Grid.Column="1"
                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="SFTP port"
                         AutomationProperties.HelpText="Defaults to 22. Only change if your server runs SSH on a different port."
                         Margin="0,4"/>

                <!-- Read-only, so the author can confirm (and copy) exactly which addresses their
                     publishes will be served from. These come from the manager's built-in
                     registry address, not from anything editable here. -->
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Registry is served from:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="9" Grid.Column="1"
                         Text="{Binding PublishedRegistryUrl, Mode=OneWay}"
                         IsReadOnly="True"
                         AutomationProperties.Name="Registry is served from"
                         AutomationProperties.HelpText="Read-only. The address every manager fetches the signed registry from."
                         FontFamily="Consolas"
                         Margin="0,4"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="Indexes are served from:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="10" Grid.Column="1"
                         Text="{Binding PublishedIndexUrlPattern, Mode=OneWay}"
                         IsReadOnly="True"
                         AutomationProperties.Name="Indexes are served from"
                         AutomationProperties.HelpText="Read-only. Where each plugin's index.json lands, with your plugin id in place of the placeholder."
                         FontFamily="Consolas"
                         Margin="0,4"/>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   AutomationProperties.LiveSetting="Polite"
                   TextWrapping="Wrap"
                   Margin="0,8,0,8"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Test connection"
                    Command="{Binding TestConnectionCommand}"
                    AutomationProperties.Name="Test connection to server"
                    MinWidth="120" Margin="0,0,8,0"/>
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="Save server upload settings"
                    IsDefault="True"
                    MinWidth="80" Margin="0,0,8,0"/>
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancel server upload settings"
                    IsCancel="True"
                    MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
